generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaConnection {
  id             String   @id @default(cuid())
  name           String
  businessId     String?
  adAccountId    String?
  encryptedToken String?
  status         String   @default("DISCONNECTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SyncRun {
  id         String    @id @default(cuid())
  kind       String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  errorCode  String?
  details    Json?
}

model MetaApiOperation {
  id             String   @id @default(cuid())
  operationId    String   @unique
  idempotencyKey String   @unique
  kind           String
  state          String   @default("REQUESTED")
  request        Json?
  response       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  source     String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  result     String
  metadata   Json?
  createdAt  DateTime @default(now())
}
